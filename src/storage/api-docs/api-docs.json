                ],
                "summary": "Show sensor",
                "operationId": "15b5e58505c8f2a1f2232e210021b7e1",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sensor details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "Modules\\Sensor\\Data\\SensorData"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "tags": [
                    "Sensors"
                ],
                "summary": "Update sensor",
                "operationId": "58c8435aad4aa8495660f9f6bd249ad7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "Modules\\Sensor\\Data\\UpdateSensorData"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Sensor updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "Modules\\Sensor\\Data\\SensorData"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "tags": [
                    "Sensors"
                ],
                "summary": "Delete sensor",
                "operationId": "354b6956cab5d958c020f45b9cabb795",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Deleted"
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Register a new user account",
                "operationId": "cff73fd071f3310eaa857e8674331eaf",
                "requestBody": {
                    "description": "User registration payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UserRequestDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Registration successful"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "login user account",
                "operationId": "2d4442d06a644df0fb22e8de8a5a93dd",
                "requestBody": {
                    "description": "User Login payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequestDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Login successful"
                    },
                    "422": {
                        "description": "Validation error"
                    },
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/LoginRequestDTO"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/verify-otp": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Verify the one-time password (OTP)",
                "operationId": "a061564c8d1b9544442483f7d966f510",
                "requestBody": {
                    "description": "Verify OTP for authentication",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mobile",
                                    "otp"
                                ],
                                "properties": {
                                    "mobile": {
                                        "type": "string",
                                        "example": "09123456789"
                                    },
                                    "otp": {
                                        "type": "integer",
                                        "example": 123456
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP verified successfully"
                    },
                    "400": {
                        "description": "Invalid or expired OTP"
                    },
                    "404": {
                        "description": "User not found"
                    }
                }
            }
        },
        "/api/v1/auth/request-otp": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Request a one-time password (OTP)",
                "operationId": "bb1076cdaa8505ee7200416db1453eef",
                "requestBody": {
                    "description": "Request OTP for authentication",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "mobile"
                                ],
                                "properties": {
                                    "mobile": {
                                        "type": "string",
                                        "example": "09371801145"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OTP generated successfully"
                    },
                    "404": {
                        "description": "User not found"
                    }
                }
            }
        },
        "/api/v1/auth/refresh-token": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Refresh the access token using a refresh token",
                "operationId": "f7baa8d2c3baf5fa4cbd70e0e833347b",
                "requestBody": {
                    "description": "Refresh token details",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "refresh_token"
                                ],
                                "properties": {
                                    "refresh_token": {
                                        "description": "The refresh token used to obtain a new access token.",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "New access token generated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "access_token": {
                                            "type": "string"
                                        },
                                        "token_type": {
                                            "type": "string",
                                            "example": "bearer"
                                        },
                                        "expires_in": {
                                            "description": "Time in seconds until the token expires",
                                            "type": "integer"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid or expired refresh token"
                    },
                    "404": {
                        "description": "User not found"
                    }
                }
            }
        },
        "/api/v1/groups": {
            "post": {
                "tags": [
                    "Group Management"
                ],
                "summary": "Create a new group",
                "description": "Create a new group",
                "operationId": "661756229c751aefb1fa7eacfd626c78",
                "requestBody": {
                    "description": "Details required to create a new group",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "slug"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Administrators"
                                    },
                                    "slug": {
                                        "type": "string",
                                        "example": "administrators"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Group with full access to all resources"
                                    },
                                    "permissions": {
                                        "description": "Array of permission IDs to attach to the group"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Group created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/groups/{id}": {
            "get": {
                "tags": [
                    "Group Management"
                ],
                "summary": "Retrieve a group by ID",
                "description": "Get a group by ID",
                "operationId": "e89404a62b1ee2744dafdd7d70b82beb",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the group to retrieve",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Group retrieved successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "slug": {
                                            "type": "string"
                                        },
                                        "description": {
                                            "type": "string",
                                            "nullable": true
                                        },
                                        "permissions": {}
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Group not found"
                    }
                }
            }
        },
        "/api/v1/groups/{id}/permissions": {
            "put": {
                "tags": [
                    "Group Management"
                ],
                "summary": "Update permissions of a specific group",
                "description": "Update permissions for a group",
                "operationId": "6a756e031126249729b4864b58170a03",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID of the group to update",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "description": "Permissions to assign to the group",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "permissions"
                                ],
                                "properties": {
                                    "permissions": {
                                        "description": "Array of permission IDs"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Permissions updated successfully"
                    },
                    "404": {
                        "description": "Group not found"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/roles": {
            "post": {
                "tags": [
                    "Roles"
                ],
                "summary": "Create a new role",
                "operationId": "6630954b73937152b182c1cd4ca23bac",
                "requestBody": {
                    "description": "Role creation payload",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RoleRequestDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Role created successfully"
                    },
                    "422": {
                        "description": "Validation error"
                    }
                }
            }
        },
        "/api/v1/users": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Get list of users",
                "operationId": "c15742b10ad7f62d9671725abe9f5a27",
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            },
            "post": {
                "tags": [
                    "Users"
                ],
                "summary": "Create a new user",
                "operationId": "b0c4a6775c479c255f8e2e85ba1f17aa",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "mobile",
                                    "password"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string"
                                    },
                                    "last_name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created successfully"
                    }
                }
            }
        },
        "/api/v1/users/{id}": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Get a user by ID",
                "operationId": "6ef4e9f2374c16a2a82cb41ec2b82fce",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                }
            },
            "put": {
                "tags": [
                    "Users"
                ],
                "summary": "Update a user",
                "operationId": "1bb62fa07e0740ec0619073307062471",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User updated successfully"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Users"
                ],
                "summary": "Delete a user",
                "operationId": "874249ba6cf4202944a0dc1717eb8833",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "User deleted successfully"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "LoginRequestDTO": {
                "properties": {
                    "mobile": {
                        "type": "string",
                        "example": "09123456789"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    }
                },
                "type": "object"
            },
            "RoleRequestDTO": {
                "description": "Payload for creating or updating a Role",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "admin"
                    },
                    "guard_name": {
                        "type": "string",
                        "example": "web"
                    },
                    "permissions": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            1,
                            2
                        ]
                    }
                },
                "type": "object"
            },
            "UserRequestDTO": {
                "properties": {
                    "first_name": {
                        "type": "string",
                        "example": "محمدرضا"
                    },
                    "last_name": {
                        "type": "string",
                        "example": "گوهری"
                    },
                    "username": {
                        "type": "string",
                        "example": "gohari"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "example@gandom.link"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    },
                    "mobile": {
                        "type": "string",
                        "example": "09123456789"
                    }
                },
                "type": "object"
            },
            "UserResponseDTO": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "first_name": {
                        "type": "string",
                        "example": "محمدرضا"
                    },
                    "last_name": {
                        "type": "string",
                        "example": "گوهری"
                    },
                    "username": {
                        "type": "string",
                        "example": "gohari"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "example@gandom.link"
                    },
                    "mobile": {
                        "type": "string",
                        "example": "09123456789"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-27 21:42:00"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-08-27 21:42:00"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "apiKey",
                "description": "Enter token in format (Bearer <token>)",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "tags": [
        {
            "name": "Authentication",
            "description": "Endpoints for user authentication"
        },
        {
            "name": "Group Management",
            "description": "Endpoints for managing groups and their permissions"
        },
        {
            "name": "Users",
            "description": "API Endpoints for managing users"
        },
        {
            "name": "Sensors",
            "description": "Sensors"
        },
        {
            "name": "Roles",
            "description": "Roles"
        }
    ]
}