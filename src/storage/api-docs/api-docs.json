{
    "openapi": "3.0.0",
    "info": {
        "title": "Authentication",
        "description": "Endpoints for user authentication",
        "version": "1.0.0"
    },
    "paths": {
        "/api/sensors": {
            "get": {
                "tags": [
                    "Sensors"
                ],
                "summary": "List sensors",
                "operationId": "43c6c945d16023827c0c8ae427f25b71",
                "responses": {
                    "200": {
                        "description": "List of sensors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "Modules\\Sensor\\Data\\SensorData"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "tags": [
                    "Sensors"
                ],
                "summary": "Create sensor",
                "operationId": "b46f41474a5ead9dc12e89caaae80e1c",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "Modules\\Sensor\\Data\\StoreSensorData"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Sensor created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "Modules\\Sensor\\Data\\SensorData"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sensors/{id}": {
            "get": {
                "tags": [
